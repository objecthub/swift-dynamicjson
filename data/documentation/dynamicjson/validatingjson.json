{"abstract":[{"text":"Validate JSON instances against JSON schemas using registries, dialects, and validators.","type":"text"}],"hierarchy":{"paths":[["doc://DynamicJSON/documentation/DynamicJSON"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://DynamicJSON/documentation/DynamicJSON/ValidatingJSON"},"kind":"article","metadata":{"modules":[{"name":"DynamicJSON"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Validating JSON Data"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"DynamicJSON","type":"text"}],"type":"emphasis"},{"text":" implements ","type":"text"},{"inlineContent":[{"text":"JSON Schema","type":"text"}],"type":"emphasis"},{"text":" as defined by the","type":"text"},{"text":" ","type":"text"},{"identifier":"https://datatracker.ietf.org/doc/draft-bhutton-json-schema/","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The framework is designed to be extensible so that future revisions can be supported.","type":"text"}],"type":"paragraph"},{"anchor":"Implementation-overview","level":3,"text":"Implementation overview","type":"heading"},{"inlineContent":[{"text":"A JSON schema is represented by the enumeration ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchema","isActive":true,"type":"reference"},{"text":". Schemas can be loaded from a","type":"text"},{"text":" ","type":"text"},{"text":"file, or decoded from a string or a ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" object. Within schema validation, top-level schemas","type":"text"},{"text":" ","type":"text"},{"text":"are managed by the class ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaResource","isActive":true,"type":"reference"},{"text":", which pre-processes and validates schema","type":"text"},{"text":" ","type":"text"},{"text":"values and gives them an identity. It is often easier to work with ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaResource","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"objects directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Schemas are identified by ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaIdentifier","isActive":true,"type":"reference"},{"text":" values, which are essentially URIs with","type":"text"},{"text":" ","type":"text"},{"text":"schema-specific methods. An identifier is either absolute or relative, and either a ","type":"text"},{"inlineContent":[{"text":"base","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"URI referring to a top-level schema or a non-base URI referring to a schema nested within","type":"text"},{"text":" ","type":"text"},{"text":"another schema via a URI fragment.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The semantics of a schema is defined by its ","type":"text"},{"inlineContent":[{"text":"dialect","type":"text"}],"type":"emphasis"},{"text":", which is identified by a URI that a","type":"text"},{"text":" ","type":"text"},{"text":"schema declares via keyword ","type":"text"},{"code":"$schema","type":"codeVoice"},{"text":". If no dialect is declared, top-level schemas use the","type":"text"},{"text":" ","type":"text"},{"text":"registry’s default dialect (","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDialect/draft2020","isActive":true,"type":"reference"},{"text":" unless configured otherwise), and","type":"text"},{"text":" ","type":"text"},{"text":"nested schemas inherit the dialect of their enclosing schema. Dialects implement the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDialect","isActive":true,"type":"reference"},{"text":" protocol, whose key responsibility is a factory method","type":"text"},{"text":" ","type":"text"},{"code":"validator(for:in:)","type":"codeVoice"},{"text":" creating validator objects. Validators implement","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidator","isActive":true,"type":"reference"},{"text":", whose ","type":"text"},{"code":"validate(_:)","type":"codeVoice"},{"text":" method takes a JSON instance and returns a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult","isActive":true,"type":"reference"},{"text":". The bundled implementation of the 2020-12 draft is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDraft2020","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The whole validation process is initiated and controlled by a ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaRegistry","isActive":true,"type":"reference"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"registry defines:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"a set of supported dialects with their URI identities,","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a default dialect for schemas that do not declare one,","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a set of known schema resources with their identities, and","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaProvider","isActive":true,"type":"reference"},{"text":" objects that discover and load schema resources that are not loaded","type":"text"},{"text":" ","type":"text"},{"text":"yet (see ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaFileProvider","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/StaticJSONSchemaFileProvider","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Most of the registry API is about configuring registries: registering dialects, inserting","type":"text"},{"text":" ","type":"text"},{"text":"available schema resources, and setting up providers. Once configured,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaRegistry/validator(for:dialect:)-78iot","isActive":true,"type":"reference"},{"text":" returns a ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidator","isActive":true,"type":"reference"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"schema resource, which can be used to validate any number of JSON instances.","type":"text"}],"type":"paragraph"},{"code":["// Create a new schema registry","let registry = JSONSchemaRegistry()","// Register a schema resource from a string literal","try registry.register(resource: JSONSchemaResource(string: #\"\"\"","  {","    \"$id\": \"https://example.com/schema/test\",","    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",","    \"type\": \"object\",","    \"properties\": {","      \"prop1\": {","        ...","      }","    }","  }","\"\"\"#))","...","// Load a schema resource from a file","try registry.loadSchema(from: URL(filePath: \"/Users/objecthub/foo.json\"))","...","// Make JSON schema stored in json files under the given directory discoverable","registry.register(provider:","  StaticJSONSchemaFileProvider(","    directory: URL(filePath: \"/Users/objecthub/myschema\"),","    base: JSONSchemaIdentifier(string: \"http://example.com/schemas\")!))","...","// Obtain a validator for a schema","guard let validator = try? registry.validator(for: \"https://example.com/schema/test\") else {","  // Throw error stating that the schema could not be found","}","// Validate a JSON instance `json`","let result = validator.validate(json)","print(\"valid = \\(result.isValid)\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Validators return ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult","isActive":true,"type":"reference"},{"text":" values. Besides validation errors, a result","type":"text"},{"text":" ","type":"text"},{"text":"collects format constraints, metadata tags, and default values; see ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/SchemaAnnotations","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/isValid","isActive":true,"type":"reference"},{"text":" to find out whether validation succeeded; if it is","type":"text"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/errors","isActive":true,"type":"reference"},{"text":" describes what went wrong.","type":"text"}],"type":"paragraph"},{"anchor":"Validation-API","level":3,"text":"Validation API","type":"heading"},{"inlineContent":[{"text":"Applications that validate instances against a small number of fixed schemas do not need","type":"text"},{"text":" ","type":"text"},{"text":"the low-level API above. ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON","isActive":true,"type":"reference"},{"text":" provides convenience methods for this case:","type":"text"}],"type":"paragraph"},{"code":["enum JSON: Hashable, ... {","  // Returns true if this JSON document is valid for the given JSON schema (using","  // `registry` for resolving references to schemas referred to from `schema`).","  func valid(for schema: JSONSchema,","             dialect: JSONSchemaDialect? = nil,","             using registry: JSONSchemaRegistry? = nil) -> Bool","","  // Returns a schema validation result for this JSON document validated against `schema`.","  func validate(with schema: JSONSchema,","                dialect: JSONSchemaDialect? = nil,","                using registry: JSONSchemaRegistry? = nil) throws -> JSONSchemaValidationResult","","  // The same, for schema resources.","  func valid(for resource: JSONSchemaResource,","             dialect: JSONSchemaDialect? = nil,","             using registry: JSONSchemaRegistry? = nil) -> Bool","  func validate(with resource: JSONSchemaResource,","                dialect: JSONSchemaDialect? = nil,","                using registry: JSONSchemaRegistry? = nil) throws -> JSONSchemaValidationResult","  ...","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If ","type":"text"},{"code":"registry","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", a new registry is created on demand in which only the provided schema","type":"text"},{"text":" ","type":"text"},{"text":"or resource is registered. Schemas that are not self-contained therefore require a suitably","type":"text"},{"text":" ","type":"text"},{"text":"configured registry. Alternatively, ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaRegistry/default","isActive":true,"type":"reference"},{"text":" provides a single, shared,","type":"text"},{"text":" ","type":"text"},{"text":"global registry.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://DynamicJSON/documentation/DynamicJSON":{"abstract":[{"text":"Represent, query, mutate, merge, and validate generic JSON values.","type":"text"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON","kind":"symbol","role":"collection","title"