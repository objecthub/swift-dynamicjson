"init"},{"kind":"text","text":"()"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser/init()","kind":"symbol","role":"symbol","title":"init()","type":"topic","url":"/documentation/dynamicjson/jsonpartialparser/init()"},"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser/isComplete":{"abstract":[{"text":"Returns true if a complete JSON value was received. A top-level number is only","type":"text"},{"text":" ","type":"text"},{"text":"complete after calling ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":", since further digits might still arrive.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isComplete"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser/isComplete","kind":"symbol","role":"symbol","title":"isComplete","type":"topic","url":"/documentation/dynamicjson/jsonpartialparser/iscomplete"},"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser/snapshot()":{"abstract":[{"text":"Returns the best approximation of the JSON value received so far, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if not enough","type":"text"},{"text":" ","type":"text"},{"text":"input was received for building a value. Throws an error if the input is malformed","type":"text"},{"text":" ","type":"text"},{"text":"in a way that was not detected by the parser while reading the input (e.g. a lone","type":"text"},{"text":" ","type":"text"},{"text":"surrogate in a string).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"snapshot"},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11DynamicJSON0B0O","text":"JSON"},{"kind":"text","text":"?"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser/snapshot()","kind":"symbol","role":"symbol","title":"snapshot()","type":"topic","url":"/documentation/dynamicjson/jsonpartialparser/snapshot()"},"doc://DynamicJSON/documentation/DynamicJSON/JSONResultSequence":{"abstract":[{"text":"A lazy sequence of results, one for each JSON value found in a sequence of bytes. Use","type":"text"},{"text":" ","type":"text"},{"code":"JSON.results(from:format:options:)","type":"codeVoice"},{"text":" to create a ","type":"text"},{"code":"JSONResultSequence","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONResultSequence"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONResultSequence","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONResultSequence"}],"role":"symbol","title":"JSONResultSequence","type":"topic","url":"/documentation/dynamicjson/jsonresultsequence"},"doc://DynamicJSON/documentation/DynamicJSON/JSONResultStream":{"abstract":[{"text":"An asynchronous sequence of results, one for each JSON value found in an asynchronous","type":"text"},{"text":" ","type":"text"},{"text":"sequence of bytes. Use ","type":"text"},{"code":"JSON.results(from:format:options:)","type":"codeVoice"},{"text":" to create a ","type":"text"},{"code":"JSONResultStream","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Malformed values do not throw; they are returned as failures, which allows a client to","type":"text"},{"text":" ","type":"text"},{"text":"decide whether and how to continue. The stream ends after a fatal error (see","type":"text"},{"text":" ","type":"text"},{"code":"JSON.StreamError.isFatal","type":"codeVoice"},{"text":") was returned.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONResultStream"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONResultStream","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONResultStream"}],"role":"symbol","title":"JSONResultStream","type":"topic","url":"/documentation/dynamicjson/jsonresultstream"},"doc://DynamicJSON/documentation/DynamicJSON/JSONStreamWriter":{"abstract":[{"text":"A ","type":"text"},{"code":"JSONStreamWriter","type":"codeVoice"},{"text":" turns JSON values into the bytes of a stream in one of the formats","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"JSON.StreamFormat","type":"codeVoice"},{"text":"; it is the counterpart of ","type":"text"},{"code":"JSON.values(from:format:options:)","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"writer does not do any I/O. Each call of ","type":"text"},{"code":"write","type":"codeVoice"},{"text":" returns the bytes that need to be","type":"text"},{"text":" ","type":"text"},{"text":"appended to the output (a file, a network connection, …). When all values were written,","type":"text"},{"text":" ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" returns the closing bytes of the stream.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONStreamWriter"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONStreamWriter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONStreamWriter"}],"role":"symbol","title":"JSONStreamWriter","type":"topic","url":"/documentation/dynamicjson/jsonstreamwriter"},"doc://DynamicJSON/documentation/DynamicJSON/JSONValueStream":{"abstract":[{"text":"An asynchronous sequence of the JSON values found in an asynchronous sequence of bytes.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"JSON.values(from:format:options:)","type":"codeVoice"},{"text":" to create a ","type":"text"},{"code":"JSONValueStream","type":"codeVoice"},{"text":". Iterating over","type":"text"},{"text":" ","type":"text"},{"text":"the stream throws a ","type":"text"},{"code":"JSON.StreamError","type":"codeVoice"},{"text":" if the input is malformed (unless the error policy","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"JSON.StreamErrorPolicy.skipInvalid","type":"codeVoice"},{"text":"). The stream ends after an error was thrown.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONValueStream"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONValueStream","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONValueStream"}],"role":"symbol","title":"JSONValueStream","type":"topic","url":"/documentation/dynamicjson/jsonvaluestream"},"doc://DynamicJSON/documentation/DynamicJSON/PartialJSON":{"abstract":[{"text":"A snapshot of a JSON value that is received in fragments; see ","type":"text"},{"code":"JSONPartialParser","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PartialJSON"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/PartialJSON","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PartialJSON"}],"role":"symbol","title":"PartialJSON","type":"topic","url":"/documentation/dynamicjson/partialjson"},"doc://DynamicJSON/documentation/DynamicJSON/PartialJSONStream":{"abstract":[{"text":"An asynchronous sequence of successive snapshots of a JSON value that arrives in","type":"text"},{"text":" ","type":"text"},{"text":"fragments, such as the structured output of a large language model. Use","type":"text"},{"text":" ","type":"text"},{"code":"JSON.partialValues(from:)","type":"codeVoice"},{"text":" to create a ","type":"text"},{"code":"PartialJSONStream","type":"codeVoice"},{"text":". A new snapshot is returned","type":"text"},{"text":" ","type":"text"},{"text":"whenever the approximation of the value changes. The last snapshot is the complete","type":"text"},{"text":" ","type":"text"},{"text":"value. If the stream of fragments ends before the value is complete, or if the","type":"text"},{"text":" ","type":"text"},{"text":"fragments are not valid JSON, the sequence throws a ","type":"text"},{"code":"JSON.StreamError","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PartialJSONStream"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/PartialJSONStream","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PartialJSONStream"}],"role":"symbol","title":"PartialJSONStream","type":"topic","url":"/documentation/dynamicjson/partialjsonstream"},"doc://DynamicJSON/documentation/DynamicJSON/ServerSentEvent":{"abstract":[{"text":"An event of a server-sent event stream (","type":"text"},{"code":"text/event-stream","type":"codeVoice"},{"text":"), as specified by the","type":"text"},{"text":" ","type":"text"},{"text":"WHATWG HTML standard. Servers use this format for pushing events to clients; it is","type":"text"},{"text":" ","type":"text"},{"text":"the transport used by most streaming APIs for large language models.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ServerSentEvent"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/ServerSentEvent","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ServerSentEvent"}],"role":"symbol","title":"ServerSentEvent","type":"topic","url":"/documentation/dynamicjson/serversentevent"},"doc://DynamicJSON/documentation/DynamicJSON/ServerSentEventStream":{"abstract":[{"text":"An asynchronous sequence of the server-sent events found in an asynchronous sequence of","type":"text"},{"text":" ","type":"text"},{"text":"bytes. Use ","type":"text"},{"code":"JSON.events(from:)","type":"codeVoice"},{"text":" to create a ","type":"text"},{"code":"ServerSentEventStream","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ServerSentEventStream"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/ServerSentEventStream","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ServerSentEventStream"}],"role":"symbol","title":"ServerSentEventStream","type":"topic","url":"/documentation/dynamicjson/serversenteventstream"},"doc://DynamicJSON/documentation/DynamicJSON/StreamingFromAPIs":{"abstract":[{"text":"Process server-sent events and JSON values that arrive in fragments, such as the output of","type":"text"},{"text":" ","type":"text"},{"text":"large language models.","type":"text"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/StreamingFromAPIs","kind":"article","role":"collectionGroup","title":"Streaming JSON from Web APIs and LLMs","type":"topic","url":"/documentation/dynamicjson/streamingfromapis"},"doc://DynamicJSON/documentation/DynamicJSON/StreamingJSON":{"abstract":[{"text":"Read sequences of JSON values from files, network responses, and pipes, one value at a time.","type":"text"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/StreamingJSON","kind":"article","role":"collectionGroup","title":"Streaming JSON Values","type":"topic","url":"/documentation/dynamicjson/streamingjson"},"doc://DynamicJSON/documentation/DynamicJSON/WritingStreams":{"abstract":[{"text":"Create NDJSON files, JSON text sequences, JSON arrays, and server-sent events from JSON values.","type":"text"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/WritingStreams","kind":"article","role":"collectionGroup","title":"Writing Streams of JSON Values","type":"topic","url":"/documentation/dynamicjson/writingstreams"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Streaming-JSON-values","generated":true,"identifiers":["doc://DynamicJSON/docume