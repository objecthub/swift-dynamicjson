{"abstract":[{"text":"Select and extract values from a JSON document with JSON Path queries, and extend the query","type":"text"},{"text":" ","type":"text"},{"text":"language with custom functions.","type":"text"}],"hierarchy":{"paths":[["doc://DynamicJSON/documentation/DynamicJSON"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://DynamicJSON/documentation/DynamicJSON/QueryingJSON"},"kind":"article","metadata":{"modules":[{"name":"DynamicJSON"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Queries with JSON Path"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"DynamicJSON","type":"text"}],"type":"emphasis"},{"text":" supports the full ","type":"text"},{"inlineContent":[{"text":"JSON Path","type":"text"}],"type":"emphasis"},{"text":" standard as defined by","type":"text"},{"text":" ","type":"text"},{"identifier":"https://datatracker.ietf.org/doc/html/rfc9535/","isActive":true,"type":"reference"},{"text":". The enumeration ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPath","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"represents queries, and ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON","isActive":true,"type":"reference"},{"text":" provides ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" methods to apply a query to a value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The examples below use the following document (taken from RFC 9535):","type":"text"}],"type":"paragraph"},{"code":["let jval = try JSON(string: \"\"\"","  { \"store\": {","      \"book\": [","        { \"category\": \"reference\",","          \"author\": \"Nigel Rees\",","          \"title\": \"Sayings of the Century\",","          \"price\": 8.95 },","        { \"category\": \"fiction\",","          \"author\": \"Evelyn Waugh\",","          \"title\": \"Sword of Honour\",","          \"price\": 12.99 },","        { \"category\": \"fiction\",","          \"author\": \"Herman Melville\",","          \"title\": \"Moby Dick\",","          \"isbn\": \"0-553-21311-3\",","          \"price\": 8.99 },","        { \"category\": \"fiction\",","          \"author\": \"J. R. R. Tolkien\",","          \"title\": \"The Lord of the Rings\",","          \"isbn\": \"0-395-19395-8\",","          \"price\": 22.99 }","      ],","      \"bicycle\": {","        \"color\": \"red\",","        \"price\": 399","      }","    }","  }","  \"\"\")"],"syntax":"swift","type":"codeListing"},{"anchor":"Running-a-query","level":3,"text":"Running a query","type":"heading"},{"inlineContent":[{"text":"A query such as ","type":"text"},{"code":"$.store.book[?@.price < 10].title","type":"codeVoice"},{"text":" is parsed with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPath/init(query:strict:)","isActive":true,"type":"reference"},{"text":" and applied with ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/query(_:)-8ldp2","isActive":true,"type":"reference"},{"text":". The result is an","type":"text"},{"text":" ","type":"text"},{"text":"array of ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/LocatedJSON","isActive":true,"type":"reference"},{"text":" values, each combining a matching value with the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation","isActive":true,"type":"reference"},{"text":" where it was found.","type":"text"}],"type":"paragraph"},{"code":["let path = try JSONPath(query: \"$.store.book[?@.price < 10].title\")","let results = try jval.query(path)","for result in results {","  print(result)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This prints:","type":"text"}],"type":"paragraph"},{"code":["$['store']['book'][0]['title'] => \"Sayings of the Century\"","$['store']['book'][2]['title'] => \"Moby Dick\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"If only values or only locations are needed, use ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/query(values:)-hsd1","isActive":true,"type":"reference"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/query(locations:)-7nc3i","isActive":true,"type":"reference"},{"text":". All query methods are also available with a query string","type":"text"},{"text":" ","type":"text"},{"text":"instead of a ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPath","isActive":true,"type":"reference"},{"text":" value.","type":"text"}],"type":"paragraph"},{"code":["let titles = try jval.query(values: \"$.store.book[?@.price < 10].title\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"By default, queries are parsed in ","type":"text"},{"inlineContent":[{"text":"strict","type":"text"}],"type":"emphasis"},{"text":" mode, which follows RFC 9535 closely. Pass","type":"text"},{"text":" ","type":"text"},{"code":"strict: false","type":"codeVoice"},{"text":" to ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPath/init(query:strict:)","isActive":true,"type":"reference"},{"text":" to relax the parser.","type":"text"}],"type":"paragraph"},{"anchor":"Custom-functions","level":3,"text":"Custom functions","type":"heading"},{"inlineContent":[{"text":"JSON Path has a built-in extensibility mechanism for functions used in filter expressions.","type":"text"},{"text":" ","type":"text"},{"text":"The standard functions ","type":"text"},{"code":"length","type":"codeVoice"},{"text":", ","type":"text"},{"code":"count","type":"codeVoice"},{"text":", ","type":"text"},{"code":"match","type":"codeVoice"},{"text":", ","type":"text"},{"code":"search","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" are provided by","type":"text"},{"text":" ","type":"text"},{"text":"the default ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPathEnvironment","isActive":true,"type":"reference"},{"text":". To add custom functions or variables, subclass","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPathEnvironment","isActive":true,"type":"reference"},{"text":" and override ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPathEnvironment/initialize()","isActive":true,"type":"reference"},{"text":". Register","type":"text"},{"text":" ","type":"text"},{"text":"functions as ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPathEvaluator/Function","isActive":true,"type":"reference"},{"text":" values describing argument types, the result","type":"text"},{"text":" ","type":"text"},{"text":"type, and an implementation:","type":"text"}],"type":"paragraph"},{"code":["class MyEnvironment: JSONPathEnvironment {","  override func initialize() {","    super.initialize()","    self.functions[\"double\"] = JSONPathEvaluator.Function(","      argtypes: [.jsonType],","      restype: .jsonType,","      impl: { root, current, args throws in","        guard case .json(.some(let json)) = args[0], let num = json.doubleValue else {","          return .json(nil)","        }","        return .json(.float(num * 2))","      })","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The extended environment is passed to ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPathEvaluator/init(value:env:strict:)","isActive":true,"type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"executes queries against a given document using that environment:","type":"text"}],"type":"paragraph"},{"code":["let evaluator = JSONPathEvaluator(value: jval, env: MyEnvironment())","let results = try evaluator.query(try JSONPath(query: \"$.store.book[?double(@.price) > 20]\"))"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://DynamicJSON/documentation/DynamicJSON":{"abstract":[{"text":"Represent, query, mutate, merge, and validate generic JSON values.","type":"text"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON","kind":"symbol","role":"collection","title":"DynamicJSON","type":"topic","url":"/documentation/dynamicjson"},"doc://DynamicJSON/documentation/DynamicJSON/JSON":{"abstract":[{"text":"Generic representation of a JSON document.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSON"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSON"}],"role":"symbol","title":"JSON","type":"topic","url":"/documentation/dynamicjson/json"},"doc://DynamicJSON/documentation/DynamicJSON/JSON/query(_:)-8ldp2":{"abstract":[{"text":"Executes the given JSON path query and returns all matching JSON values with their","type":"text"},{"text":" ","type":"text"},{"text":"corresponding locations.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"query"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11DynamicJSON8JSONPathO","text":"JSONPath"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:11DynamicJSON07LocatedB0V","text":"LocatedJSON"},{"kind":"text","text":"]"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/query(_:)-8ldp2","kind":"symbol","role":"symbol","title":"query(_:)","type":"topic","url":"/documentation/dynamicjson/json/query(_:)-8ldp2"},"doc://DynamicJSON/documentation/DynamicJSON/JSON/query(locations:)-7nc3i":{"abstr