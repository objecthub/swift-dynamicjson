ode":"JSONPath","type":"codeVoice"},{"text":" queries, ","type":"text"},{"code":"JSONLocation","type":"codeVoice"},{"text":" references refer to at most one","type":"text"},{"text":" ","type":"text"},{"text":"value within a JSON document.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONLocation"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONLocation"}],"role":"symbol","title":"JSONLocation","type":"topic","url":"/documentation/dynamicjson/jsonlocation"},"doc://DynamicJSON/documentation/DynamicJSON/JSONPatch":{"abstract":[{"text":"Representation of a sequence of mutations applicable to JSON documents","type":"text"},{"text":" ","type":"text"},{"text":"based on RFC 6902. JSON Patch defines a JSON-based document structure","type":"text"},{"text":" ","type":"text"},{"text":"for expressing a sequence of operations to apply to JSON data.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONPatch"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPatch","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONPatch"}],"role":"symbol","title":"JSONPatch","type":"topic","url":"/documentation/dynamicjson/jsonpatch"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchema":{"abstract":[{"text":"Representation of a JSON schema. A JSON schema is either boolean (i.e. validation","type":"text"},{"text":" ","type":"text"},{"text":"yields always true or false), or it is a collection of keywords specified by a","type":"text"},{"text":" ","type":"text"},{"text":"“descriptor”. The descriptor is a structured interpretation of a schema definition","type":"text"},{"text":" ","type":"text"},{"text":"provided as a second parameter to case ","type":"text"},{"code":"descriptor","type":"codeVoice"},{"text":".","type":"text"}],"fragm