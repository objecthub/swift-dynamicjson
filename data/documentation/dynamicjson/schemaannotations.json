:"JSONSchemaDraft2020","type":"codeVoice"},{"text":" ","type":"text"},{"text":"vocabulary.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONSchemaFormatValidators"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaFormatValidators","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONSchemaFormatValidators"}],"role":"symbol","title":"JSONSchemaFormatValidators","type":"topic","url":"/documentation/dynamicjson/jsonschemaformatvalidators"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaIdentifier":{"abstract":[{"text":"URI representing a JSON schema identifier.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONSchemaIdentifier"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaIdentifier","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONSchemaIdentifier"}],"role":"symbol","title":"JSONSchemaIdentifier","type":"topic","url":"/documentation/dynamicjson/jsonschemaidentifier"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaProvider":{"abstract":[{"text":"A schema provider discovers and loads schema resources on demand. Registries consult","type":"text"},{"text":" ","type":"text"},{"text":"their providers for schemas that have not been registered explicitly.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONSchemaProvider"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaProvider","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONSchemaProvider"}],"role":"symbol","title":"JSONSchemaProvider","type":"topic","url":"/documentation/dynamicjson/jsonschemaprovider"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaRegistry":{"abstract":[{"text":"Class ","type":"text"},{"code":"JSONSchemaRegistry","type":"codeVoice"},{"text":" is used to define an environment of all known JSON","type":"text"},{"text":" ","type":"text"},{"text":"schema resources. Every validator application is based on such a schema registry","type":"text"},{"text":" ","type":"text"},{"text":"for looking up referenced schema.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONSchemaRegistry"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaRegistry","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONSchemaRegistry"}],"role":"symbol","title":"JSONSchemaRegistry","type":"topic","url":"/documentation/dynamicjson/jsonschemaregistry"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaResource":{"abstract":[{"text":"Implementation of JSON Schema resources. These are containers for managing JSON schema.","type":"text"},{"text":" ","type":"text"},{"text":"Each resource encapsulates one schema. It manages various indices to look up nested schema","type":"text"},{"text":" ","type":"text"},{"text":"as well as anchor definitions. Since schema might be nested, each schema also has an","type":"text"},{"text":" ","type":"text"},{"text":"optional ","type":"text"},{"code":"outer","type":"codeVoice"},{"text":" link to its enclosing schema.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONSchemaResource"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaResource","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONSchemaResource"}],"role":"symbol","title":"JSONSchemaResource","type":"topic","url":"/documentation/dynamicjson/jsonschemaresource"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationContext":{"abstract":[{"code":"JSONSchemaValidationContext","type":"codeVoice"},{"text":" values capture validation context information during","type":"text"},{"text":" ","type":"text"},{"text":"the validation process.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONSchemaValidationContext"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationContext","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONSchemaValidationContext"}],"role":"symbol","title":"JSONSchemaValidationContext","type":"topic","url":"/documentation/dynamicjson/jsonschemavalidationcontext"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult":{"abstract":[{"text":"Result container for JSON schema validators. Currently, ","type":"text"},{"code":"JSONSchemaValidationResult","type":"codeVoice"},{"text":" ","type":"text"},{"text":"values primarily collect errors, format and meta annotations, as well as defaults.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONSchemaValidationResult"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONSchemaValidationResult"}],"role":"symbol","title":"JSONSchemaValidationResult","type":"topic","url":"/documentation/dynamicjson/jsonschemavalidationresult"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/Annotation":{"abstract":[{"text":"An annotation attached to the validated ","type":"text"},{"code":"value","type":"codeVoice"},{"text":", produced by the schema at ","type":"text"},{"code":"location","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Annotation"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/Annotation","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Annotation"}],"role":"symbol","title":"JSONSchemaValidationResult.Annotation","type":"topic","url":"/documentation/dynamicjson/