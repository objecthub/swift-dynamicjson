{"abstract":[{"text":"A ","type":"text"},{"code":"JSONPartialParser","type":"codeVoice"},{"text":" reads a single JSON value that arrives in fragments of arbitrary","type":"text"},{"text":" ","type":"text"},{"text":"size, and provides access to the best available approximation of the value at any time.","type":"text"},{"text":" ","type":"text"},{"text":"This is useful for processing structured output and tool calls of large language models,","type":"text"},{"text":" ","type":"text"},{"text":"which are streamed as pieces of text that are not valid JSON by themselves.","type":"text"}],"hierarchy":{"paths":[["doc://DynamicJSON/documentation/DynamicJSON"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser"},"kind":"symbol","metadata":{"externalID":"s:11DynamicJSON17JSONPartialParserV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONPartialParser"}],"modules":[{"name":"DynamicJSON"}],"navigatorTitle":[{"kind":"identifier","text":"JSONPartialParser"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"JSONPartialParser"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONPartialParser"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"code":["var parser = JSONPartialParser()","try parser.append(#\"{\"city\": \"Par\"#)","try parser.snapshot()   // {\"city\": \"Par\"}","try parser.append(#\"is\", \"population\": 21\"#)","try parser.snapshot()   // {\"city\": \"Paris\"}","try parser.append(\"00000}\")","try parser.finish()     // {\"city\": \"Paris\", \"population\": 2100000}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"A snapshot is computed according to the following rules:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Open strings are closed. They contain the text received so far, without incomplete","type":"text"},{"text":" ","type":"text"},{"text":"escape sequences and characters. Open arrays and objects are closed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Object members whose key or value has not been received completely, are omitted. The","type":"text"},{"text":" ","type":"text"},{"text":"only exception are strings, which are returned in their partial form.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Numbers are only included once they are followed by a delimiter, because further","type":"text"},{"text":" ","type":"text"},{"text":"digits might still arrive. Literals (","type":"text"},{"code":"true","type":"codeVoice"},{"text":", ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", ","type":"text"},{"code":"null","type":"codeVoice"},{"text":") are included once they","type":"text"},{"text":" ","type":"text"},{"text":"are complete.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"As a consequence, each snapshot is a prefix of all later snapshots and of the final value:","type":"text"},{"text":" ","type":"text"},{"text":"objects only gain members, arrays only gain elements, and strings only get longer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The parser validates the structure of the input as it arrives and throws a","type":"text"},{"text":" ","type":"text"},{"code":"JSON.StreamError","type":"codeVoice"},{"text":" as soon as the input cannot be extended to a valid JSON value. After","type":"text"},{"text":" ","type":"text"},{"text":"an error, the parser does not accept any more input.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://DynamicJSON/documentation/DynamicJSON":{"abstract":[{"text":"Represent, query, mutate, merge, and validate generic JSON values.","type":"text"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON","kind":"symbol","role":"collection","title":"DynamicJSON","type":"topic","url":"/documentation/dynamicjson"},"doc://DynamicJSON/documentation/DynamicJSON/ExtractingJSON":{"abstract":[{"text":"Find JSON values in text produced by large language models, and parse JSON that is not","type":"text"},{"text":" ","type":"text"},{"text":"quite valid.","type":"text"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/ExtractingJSON","kind":"article","role":"collectionGroup","title":"Extracting JSON from LLM Output","type":"topic","url":"/documentation/dynamicjson/extractingjson"},"doc://DynamicJSON/documentation/DynamicJSON/JSONByteStream":{"abstract":[{"text":"An asynchronous sequence of chunks of data, which together form a stream of JSON values","type":"text"},{"text":" ","type":"text"},{"text":"in one of the formats of ","type":"text"},{"code":"JSON.StreamFormat","type":"codeVoice"},{"text":". Use ","type":"text"},{"code":"JSON.stream(_:format:options:)","type":"codeVoice"},{"text":" to create","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"JSONByteStream","type":"codeVoice"},{"text":" from an asynchronous sequence of JSON values. There is one chunk for each","type":"text"},{"text":" ","type":"text"},{"text":"value, followed by a chunk with the closing bytes of the stream, if there are any. The chunks","type":"text"},{"text":" ","type":"text"},{"text":"can be sent to a client as the body of a streaming HTTP response, or be written to a file.","type":"text"},{"text":" ","type":"text"},{"text":"The sequence throws a ","type":"text"},{"code":"JSON.StreamWriteError","type":"codeVoice"},{"text":" if a value cannot be encoded; errors of the","type":"text"},{"text":" ","type":"text"},{"text":"base sequence are passed on.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONByteStream"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONByteStream","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONByteStream"}],"role":"symbol","title":"JSONByteStream","type":"topic","url":"/documentation/dynamicjson/jsonbytestream"},"doc://DynamicJSON/documentation/DynamicJSON/JSONExtractionOptions":{"abstract":[{"text":"Options for extracting JSON values from text.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONExtractionOptions"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONExtractionOptions","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONExtractionOptions"}],"role":"symbol","title":"JSONExtractionOptions","type":"topic","url":"/documentation/dynamicjson/jsonextractionoptions"},"doc://DynamicJSON/documentation/DynamicJSON/JSONFragmentStream":{"abstract":[{"text":"An asynchronous sequence of the strings found at a given location in a sequence of JSON","type":"text"},{"text":" ","type":"text"},{"text":"values. Use ","type":"text"},{"code":"JSON.fragments(from:at:)","type":"codeVoice"},{"text":" to create a ","type":"text"},{"code":"JSONFragmentStream","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONFragmentStream"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONFragmentStream","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONFragmentStream"}],"role":"symbol","title":"JSONFragmentStream","type":"topic","url":"/documentation/dynamicjson/jsonfragmentstream"},"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser":{"abstract":[{"text":"A ","type":"text"},{"code":"JSONPartialParser","type":"codeVoice"},{"text":" reads a single JSON value that arrives in fragments of arbitrary","type":"text"},{"text":" ","type":"text"},{"text":"size, and provides access to the best available approximation of the value at any time.","type":"text"},{"text":" ","type":"text"},{"text":"This is useful for processing structured output and tool calls of large language models,","type":"text"},{"text":" ","type":"text"},{"text":"which are streamed as pieces of text that are not valid JSON by themselves.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONPartialParser"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONPartialParser"}],"role":"symbol","title":"JSONPartialParser","type":"topic","url":"/documentation/dynamicjson/jsonpartialparser"},"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser/append(_:)":{"abstract":[{"text":"Appends a fragment of text to the input.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"append"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser/append(_:)","kind":"symbol","role":"symbol","title":"append(_:)","type":"topic","url":"/documentation/dynamicjson/jsonpartialparser/append(_:)"},"doc://DynamicJSON/documentation/DynamicJSON/JSONPartialParser/append(contentsOf:)":{"abstract":[{"text":"Appends a fragment of UTF-8 encoded text to the input. Fragments may end in the middle","type":"text"},{"text":" ","type":"text"},{"text":"of a character.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"append"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"contentsOf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11DynamicJSON17JSONPartialParserV6append10