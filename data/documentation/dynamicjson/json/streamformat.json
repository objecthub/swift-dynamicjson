pe":"topic","url":"/documentation/dynamicjson/json/streamformat"},"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/Equatable-Implementations":{"abstract":[],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/Equatable-Implementations","kind":"article","role":"collectionGroup","title":"Equatable Implementations","type":"topic","url":"/documentation/dynamicjson/json/streamformat/equatable-implementations"},"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/arrayElements":{"abstract":[{"text":"The elements of a single top-level JSON array, ","type":"text"},{"code":"[ v1, v2, ... ]","type":"codeVoice"},{"text":", are returned one by","type":"text"},{"text":" ","type":"text"},{"text":"one, without having to hold the whole array in memory. Anything but whitespace following","type":"text"},{"text":" ","type":"text"},{"text":"the closing bracket is an error.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"arrayElements"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/arrayElements","kind":"symbol","role":"symbol","title":"JSON.StreamFormat.arrayElements","type":"topic","url":"/documentation/dynamicjson/json/streamformat/arrayelements"},"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/automatic":{"abstract":[{"text":"Chooses the format based on the first bytes of the stream: if the first non-whitespace","type":"text"},{"text":" ","type":"text"},{"text":"byte is the ASCII record separator (0x1E), the stream is read as ","type":"text"},{"code":"sequence","type":"codeVoice"},{"text":"; if it is","type":"text"},{"text":" ","type":"text"},{"text":"one of the letters starting a server-sent event field (","type":"text"},{"code":"d","type":"codeVoice"},{"text":", ","type":"text"},{"code":"e","type":"codeVoice"},{"text":", ","type":"text"},{"code":"i","type":"codeVoice"},{"text":", ","type":"text"},{"code":"r","type":"codeVoice"},{"text":") or a colon,","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"serverSentEvents","type":"codeVoice"},{"text":"; otherwise as ","type":"text"},{"code":"concatenated","type":"codeVoice"},{"text":". Since ","type":"text"},{"code":"concatenated","type":"codeVoice"},{"text":" also reads","type":"text"},{"text":" ","type":"text"},{"text":"newline-delimited values, this covers NDJSON/JSON Lines input as well, but does not","type":"text"},{"text":" ","type":"text"},{"text":"recover from malformed lines. The elements of a top-level array are never detected","type":"text"},{"text":" ","type":"text"},{"text":"automatically; use ","type":"text"},{"code":"arrayElements","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"automatic"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/automatic","kind":"symbol","role":"symbol","title":"JSON.StreamFormat.automatic","type":"topic","url":"/documentation/dynamicjson/json/streamformat/automatic"},"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/concatenated":{"abstract":[{"text":"Concatenated JSON: values follow each other with arbitrary (or no) whitespace in between,","type":"text"},{"text":" ","type":"text"},{"text":"e.g. ","type":"text"},{"code":"{\"a\":1}{\"b\":2}","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"1 2 3","type":"codeVoice"},{"text":". Top-level numbers and literals have to be separated by","type":"text"},{"text":" ","type":"text"},{"text":"whitespace from the next value. This format also reads newline-delimited input. The","type":"text"},{"text":" ","type":"text"},{"text":"boundaries of a value are determined by scanning, so after a malformed value, the","type":"text"},{"text":" ","type":"text"},{"text":"remainder of the stream might not be interpreted as intended.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"concatenated"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/concatenated","kind":"symbol","role":"symbol","title":"JSON.StreamFormat.concatenated","type":"topic","url":"/documentation/dynamicjson/json/streamformat/concatenated"},"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/lines":{"abstract":[{"text":"Newline-delimited JSON, as defined by NDJSON and JSON Lines (","type":"text"},{"code":".ndjson","type":"codeVoice"},{"text":", ","type":"text"},{"code":".jsonl","type":"codeVoice"},{"text":"). Each","type":"text"},{"text":" ","type":"text"},{"text":"line holds one JSON value. Lines may end with ","type":"text"},{"code":"\\r\\n","type":"codeVoice"},{"text":", and blank lines are ignored. After","type":"text"},{"text":" ","type":"text"},{"text":"a malformed line, reading resumes with the next line.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"lines"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/lines","kind":"symbol","role":"symbol","title":"JSON.StreamFormat.lines","type":"topic","url":"/documentation/dynamicjson/json/streamformat/lines"},"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/sequence":{"abstract":[{"text":"JSON text sequences as defined by RFC 7464 (","type":"text"},{"code":"application/json-seq","type":"codeVoice"},{"text":") and RFC 8142","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"application/geo+json-seq","type":"codeVoice"},{"text":"). Each JSON text is preceded by the ASCII record separator","type":"text"},{"text":" ","type":"text"},{"text":"(0x1E) and typically followed by a line feed. Top-level numbers, ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" that are not followed by whitespace are considered truncated and are dropped.","type":"text"},{"text":" ","type":"text"},{"text":"After a malformed text, reading resumes with the next record separator.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"sequence"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/sequence","kind":"symbol","role":"symbol","title":"JSON.StreamFormat.sequence","type":"topic","url":"/documentation/dynamicjson/json/streamformat/sequence"},"doc://DynamicJSON/documentation/DynamicJSON/JSON/StreamFormat/serverSentEvents":{"abstract":[{"text":"Server-sent events (","type":"text"},{"code":"text/event-stream","type":"codeVoice"},{"text":") as used by most streaming web APIs, including","type":"text"},{"text":" ","type":"text"},{"text":"those of large language models. The data of each event (the ","type":"text"},{"code":"data","type":"codeVoice"},{"text":" fields, joined with","type":"text"},{"text":" ","type":"text"},{"text":"line feeds) is expected to be a JSON value; events without data, comments, and","type":"text"},{"text":" ","type":"text"},{"text":"the fields ","type":"text"},{"code":"event","type":"codeVoice"},{"text":", ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"retry","type":"codeVoice"},{"text":" are ignored (use ","type":"text"},{"code":"JSON.events(from:)","type":"codeVoice"},{"text":" to access","type":"text"},{"text":" ","type":"text"},{"text":"them). If the data of an event equals ","type":"text"},{"code":"StreamOptions.terminator","type":"codeVoice"},{"text":", the stream ends.","type":"text"},{"text":" ","type":"text"},{"text":"After an event with malformed data, reading resumes with the next event.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"serverSentEvents"}],"identifier":"doc://Dy