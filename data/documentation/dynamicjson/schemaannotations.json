{"abstract":[{"text":"Access format constraints, property metadata, and default values collected during","type":"text"},{"text":" ","type":"text"},{"text":"validation.","type":"text"}],"hierarchy":{"paths":[["doc://DynamicJSON/documentation/DynamicJSON"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://DynamicJSON/documentation/DynamicJSON/SchemaAnnotations"},"kind":"article","metadata":{"modules":[{"name":"DynamicJSON"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Metadata and Defaults"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Besides errors, a ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult","isActive":true,"type":"reference"},{"text":" collects annotations produced by schema","type":"text"},{"text":" ","type":"text"},{"text":"keywords while an instance is validated.","type":"text"}],"type":"paragraph"},{"anchor":"Format-annotations","level":3,"text":"Format annotations","type":"heading"},{"inlineContent":[{"code":"format","type":"codeVoice"},{"text":" annotations, i.e. declarations that string values have a particular format, are","type":"text"},{"text":" ","type":"text"},{"text":"collected in ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/formatConstraints","isActive":true,"type":"reference"},{"text":". Each constraint is an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/Annotation","isActive":true,"type":"reference"},{"text":" of ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/FormatConstraint","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"that provides the fields ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" (a ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/LocatedJSON","isActive":true,"type":"reference"},{"text":"), ","type":"text"},{"code":"location","type":"codeVoice"},{"text":" (within the schema),","type":"text"},{"text":" ","type":"text"},{"code":"message.format","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"message.valid","type":"codeVoice"},{"text":". ","type":"text"},{"code":"message.valid","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"Bool?","type":"codeVoice"},{"text":": ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for valid","type":"text"},{"text":" ","type":"text"},{"text":"constraints, ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for invalid constraints, and ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for constraints that could not be","type":"text"},{"text":" ","type":"text"},{"text":"validated. This code prints all invalid constraints:","type":"text"}],"type":"paragraph"},{"code":["let res: JSONSchemaValidationResult = ...","for constraint in res.formatConstraints where constraint.message.valid == false {","  print(\"value \\(constraint.value) does not match format '\\(constraint.message.format)'\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"By default, invalid format constraints do not cause validation errors. To make them do so, the","type":"text"},{"text":" ","type":"text"},{"text":"vocabulary ","type":"text"},{"code":"https://json-schema.org/draft/2020-12/meta/format-annotation","type":"codeVoice"},{"text":" needs to be","type":"text"},{"text":" ","type":"text"},{"text":"enabled. This is done by creating a custom ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDraft2020/Dialect-swift.struct","isActive":true,"type":"reference"},{"text":" with a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDraft2020/Vocabulary","isActive":true,"type":"reference"},{"text":" whose ","type":"text"},{"code":"formatValid","type":"codeVoice"},{"text":" property is true. Since this is","type":"text"},{"text":" ","type":"text"},{"text":"needed frequently, the preconfigured dialect ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDialect/draft2020Format","isActive":true,"type":"reference"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"available. A registry with this dialect as its default always validates format annotations.","type":"text"},{"text":" ","type":"text"},{"text":"The built-in format checks are listed in ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaFormatValidators","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Default-annotations","level":3,"text":"Default annotations","type":"heading"},{"inlineContent":[{"code":"default","type":"codeVoice"},{"text":" annotations, i.e. declarations that properties have a given value if they are not","type":"text"},{"text":" ","type":"text"},{"text":"defined explicitly, are collected in ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/defaults","isActive":true,"type":"reference"},{"text":". This property","type":"text"},{"text":" ","type":"text"},{"text":"maps ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation","isActive":true,"type":"reference"},{"text":" values to tuples ","type":"text"},{"code":"(exists: Bool, values: Set<JSON>)","type":"codeVoice"},{"text":". ","type":"text"},{"code":"exists","type":"codeVoice"},{"text":" states","type":"text"},{"text":" ","type":"text"},{"text":"whether a value exists at the location (if so, no default needs to be injected). ","type":"text"},{"code":"values","type":"codeVoice"},{"text":" ","type":"text"},{"text":"contains all suitable defaults, since a schema can define multiple alternatives.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/nonexistingDefaults","isActive":true,"type":"reference"},{"text":" restricts the defaults to locations without","type":"text"},{"text":" ","type":"text"},{"text":"a value, and ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/defaultPatch","isActive":true,"type":"reference"},{"text":" turns them into a ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPatch","isActive":true,"type":"reference"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"adds a default value (an arbitrary one, if there are several) for each missing location.","type":"text"}],"type":"paragraph"},{"code":["let schema = try JSONSchema(string: #\"\"\"","  {","    \"$id\": \"https://objecthub.com/example/person\",","    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",","    \"title\": \"person\",","    \"type\": \"object\",","    \"properties\": {","      \"name\": {","        \"type\": \"string\",","        \"minLength\": 1","      },","      \"birthday\": {","        \"type\": \"string\",","        \"format\": \"date\"","      },","      \"numChildren\": {","        \"type\": \"integer\",","        \"default\": 0","      },","      \"address\": {","        \"oneOf\": [","          { \"type\": \"string\", \"default\": \"12345 Mcity\" },","          { \"$ref\": \"#address\",","            \"default\": { \"city\": \"Mcity\", \"postalCode\": \"12345\" } }","        ]","      },","      \"email\": {","        \"type\": \"array\",","        \"maxItems\": 3,","        \"items\": {","          \"type\": \"string\",","          \"format\": \"email\"","        }","      }","    },","    \"required\": [\"name\", \"birthday\"],","    \"$defs\": {","      \"address\": {","        \"$anchor\": \"address\",","        \"type\": \"object\",","        \"properties\": {","          \"street\": { \"type\": \"string\" },","          \"city\": { \"type\": \"string\" },","          \"postalCode\": { \"type\": \"string\", \"pattern\": \"\\\\d{5}\" }","        },","        \"required\": [\"city\", \"postalCode\"]","      }","    }","  }","\"\"\"#)","/// `instance0` is a valid instance of `schema`","let instance0: JSON = [","  \"name\": \"John Doe\",","  \"birthday\": \"1983-03-19\",","  \"numChildren\": 2,","  \"email\": [\"john@doe.com\", \"john.doe@gmail.com\"]","]","instance0.valid(for: schema) ⇒ true","/// `instance1` is not a valid instance of `schema`","let instance1: JSON = [","  \"name\": \"John Doe\",","  \"email\": [\"john@doe.com\", \"john.doe@gmail.com\"]","]","instance1.valid(for: schema) ⇒ false","/// `instance2` is a valid instance of `schema`","let instance2: JSON = [","  \"name\": \"John Doe\",","  \"birthday\": \"1983-03-19\",","  \"address\": \"12 Main Street, 17445 Noname\"","]","let res2 = try instance2.validate(with: schema)","res2.isValid ⇒ true","for (location, (exists, values)) in res2.defaults {","  if exists {","    print(\"\\(location) exists; defaults: \\(values)\")","  } else {","    print(\"\\(location) does not exist; defaults: \\(values)\")","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The loop at the end prints:","type":"text"}],"type":"paragraph"},{"code":["$['numChildren'] does not exist; defaults: [0]","$['address'] exists; defaults: [","  \"12345 Mcity\",","  {","    \"postalCode\" : \"12345\",","    \"city\" : \"Mcity\"","  }","]"],"syntax":null,"type":"codeListing"},{"anchor":"Property-metadata","level":3,"text":"Property metadata","type":"heading"},{"inlineContent":[{"text":"Metadata annotations such as ","type":"text"},{"code":"deprecated","type":"codeVoice"},{"text":", ","type":"text"},{"code":"readOnly","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"writeOnly","type":"codeVoice"},{"text":" are collected in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/tags","isActive":true,"type":"reference"},{"text":". Each location within the validated value that carries","type":"text"},{"text":" ","type":"text"},{"text":"such an annotation has an entry of type ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/Annotation","isActive":true,"type":"reference"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaValidationResult/MetaTags","isActive":true,"type":"reference"},{"text":" as message, giving access to ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" (a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/LocatedJSON","isActive":true,"type":"reference"},{"text":"), ","type":"text"},{"code":"location","type":"codeVoice"},{"text":" (within the schema), and the option set members","type":"text"},{"text":" ","type":"text"},{"code":"message.deprecated","type":"codeVoice"},{"text":", ","type":"text"},{"code":"message.readOnly","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"message.writeOnly","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://DynamicJSON/documentation/DynamicJSON":{"abstract":[{"text":"Represent, query, mutate, merge, and validate generic JSON values.","type":"text"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON","kind":"symbol","role":"collection","title":"DynamicJSON","type":"topic","url":"/documentation/dynamicjson"},"doc://DynamicJSON/documentation/DynamicJSON/AnnotationMessage":{"abstract":[{"text":"Protocol defining type for annotation messages.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnnotationMessage"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/AnnotationMessage","kind":"symbol","nav