t"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11DynamicJSON19JSONSchemaDraft2020C","text":"JSONSchemaDraft2020"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:11DynamicJSON19JSONSchemaDraft2020C7DialectV","text":"Dialect"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDialect/draft2020Format","kind":"symbol","role":"symbol","title":"draft2020Format","type":"topic","url":"/documentation/dynamicjson/jsonschemadialect/draft2020format"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDraft2020":{"abstract":[{"text":"Implementation of JSON schema validation based on the JSON schema Draft 2020-12","type":"text"},{"text":" ","type":"text"},{"text":"standard. The validator is configured via its ","type":"text"},{"code":"Dialect","type":"codeVoice"},{"text":" descriptor which uses","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"Vocabulary","type":"codeVoice"},{"text":" value to declare what vocaularies of the schema are being","type":"text"},{"text":" ","type":"text"},{"text":"evaluated.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONSchemaDraft2020"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDraft2020","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONSchemaDraft2020"}],"role":"symbol","title":"JSONSchemaDraft2020","type":"topic","url":"/documentation/dynamicjson/jsonschemadraft2020"},"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDraft2020/Dialect-swift.struct":{"abstract":[{"text":"Draft 2020-20 dialect representation","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Dialect"}],"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONSchemaDraft2020/Dialect-swift.struct","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Dialect"}],"rol