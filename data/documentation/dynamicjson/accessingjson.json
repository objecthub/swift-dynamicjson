 which this reference is pointing from JSON document `value`.","  func get(from value: JSON) -> JSON?","  // Replace value at which this reference is pointing with `json` within `value`.","  func set(to json: JSON, in value: JSON) throws -> JSON","  // Mutate value at which this reference is pointing within JSON document `value`","  // with function `proc`.","  func mutate(_ json: inout JSON, with proc: (inout JSON) throws -> Void,","              insert: Bool) throws","}","","protocol SegmentableJSONReference: JSONReference {","  associatedtype Segment: JSONReferenceSegment","  // An array of segments representing the reference.","  var segments: [Segment] { get }","  // Creates a new `SegmentableJSONReference` on top of this reference.","  func select(segment: Segment) -> Self","  // Decomposes this reference into the top segment selector and its parent.","  var deselect: (Self, Segment)? { get }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"DynamicJSON","type":"text"}],"type":"emphasis"},{"text":" provides two implementations of ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/SegmentableJSONReference","isActive":true,"type":"reference"},{"text":":","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPointer","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation","isActive":true,"type":"reference"},{"text":", an abstraction equivalent to singular ","type":"text"},{"inlineContent":[{"text":"JSON Path","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"queries.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Reference strings are interpreted by ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSON/reference(from:)","isActive":true,"type":"reference"},{"text":": strings starting with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are parsed as ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPointer","isActive":true,"type":"reference"},{"text":"; all other non-empty strings as ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation","isActive":true,"type":"reference"},{"text":" (the leading","type":"text"},{"text":" ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" may be omitted); the empty string refers to the root.","type":"text"}],"type":"paragraph"},{"anchor":"JSON-Location","level":3,"text":"JSON Location","type":"heading"},{"inlineContent":[{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation","isActive":true,"type":"reference"},{"text":" is the default way of identifying JSON values within a JSON document. It","type":"text"},{"text":" ","type":"text"},{"text":"is based on how values are identified in","type":"text"},{"text":" ","type":"text"},{"identifier":"https://datatracker.ietf.org/doc/html/rfc9535/","isActive":true,"type":"reference"},{"text":" and uses a restricted form of","type":"text"},{"text":" ","type":"text"},{"text":"the JSON Path query syntax. A ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation","isActive":true,"type":"reference"},{"text":" refers to at most one value within a document","type":"text"},{"text":" ","type":"text"},{"text":"and is defined as a sequence of member names and array indices:","type":"text"}],"type":"paragraph"},{"code":["indirect enum JSONLocation: SegmentableJSONReference, Codable, Hashable, CustomStringConvertible {","  case root","  case member(JSONLocation, String)","  case index(JSONLocation, Int)","","  enum Segment: JSONReferenceSegment, Codable, Hashable, CustomStringConvertible {","    case member(String)","    case index(Int)","    ...","  }","  ...","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each location starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", the root of the document. Members can be expressed with dot","type":"text"},{"text":" ","type":"text"},{"text":"notation or with bracket notation; array indices always use brackets:","type":"text"}],"type":"paragraph"},{"code":["$.store.book[0].title","$['store']['book'][0]['title']","$['store'].book[-1].title"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Negative indices are offsets from the end of an array, with ","type":"text"},{"code":"-1","type":"codeVoice"},{"text":" referring to the last","type":"text"},{"text":" ","type":"text"},{"text":"element.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Locations can be created from strings or from segments:","type":"text"}],"type":"paragraph"},{"code":["let r1 = try JSONLocation(\"$['store']['book'][0]['title']\")","let r2 = JSONLocation(segments: [.member(\"store\"),","                                 .member(\"book\"),","                                 .index(0),","                                 .member(\"title\")])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Useful members of ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation","isActive":true,"type":"reference"},{"text":" include ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation/select(member:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation/select(index:)","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation/select(segment:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation/pointer","isActive":true,"type":"reference"},{"text":" (a matching ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPointer","isActive":true,"type":"reference"},{"text":", if one exists),","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation/path","isActive":true,"type":"reference"},{"text":" (a matching ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPath","isActive":true,"type":"reference"},{"text":" query), ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation/get(from:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation/set(to:in:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONLocation/mutate(_:with:insert:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"JSON-Pointer","level":3,"text":"JSON Pointer","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"JSON Pointer","type":"text"}],"type":"emphasis"},{"text":" is specified by ","type":"text"},{"identifier":"https://datatracker.ietf.org/doc/html/rfc6901/","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"and is the most established formalism for referring to a value within a JSON document. It","type":"text"},{"text":" ","type":"text"},{"text":"is designed to be easily embedded in JSON string values and URI fragment identifiers","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"identifier":"https://datatracker.ietf.org/doc/html/rfc3986/","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A JSON pointer is a path starting at the root of a document. Each path element is prefixed","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" and either refers to an object member or an array index. ","type":"text"},{"code":"~1","type":"codeVoice"},{"text":" encodes ","type":"text"},{"code":"/","type":"codeVoice"},{"text":" in member","type":"text"},{"text":" ","type":"text"},{"text":"names and ","type":"text"},{"code":"~0","type":"codeVoice"},{"text":" encodes ","type":"text"},{"code":"~","type":"codeVoice"},{"text":". The empty string refers to the root.","type":"text"}],"type":"paragraph"},{"code":["/store/book/0/title"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"JSON Pointer neither distinguishes array indices from numeric member names — ","type":"text"},{"code":"/0","type":"codeVoice"},{"text":" can select","type":"text"},{"text":" ","type":"text"},{"text":"index 0 of an array or member ","type":"text"},{"code":"\"0\"","type":"codeVoice"},{"text":" of an object — nor supports negative indices. Thus, there","type":"text"},{"text":" ","type":"text"},{"text":"is no general mapping between JSON locations and JSON pointers;","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPointer/locations()","isActive":true,"type":"reference"},{"text":" returns all locations a pointer could correspond to.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPointer","isActive":true,"type":"reference"},{"text":" is a struct with ","type":"text"},{"identifier":"doc://DynamicJSON/documentation/DynamicJSON/JSONPointer/ReferenceToken","isActive":true,"type":"reference"},{"text":" segments:","type":"text"}],"type":"paragraph"},{"code":["struct JSONPointer: SegmentableJSONReference, Codable, Hashable, CustomStringConvertible {","  let segments: [ReferenceToken]","","  enum ReferenceToken: JSONReferenceSegment, Hashable, CustomStringConvertible {","    case member(String)","    case index(String, Int?)","    ...","  }","  ...","}"],"syntax":"swift","type":"codeListing"},{"inlineCo